{
  "manifest_version": 3,
  "name": "Hourglass Connector",
  "version": "1.0.0",
  "description": "Lets the Hourglass app auto-switch timers based on the website you're on (YouTube, Instagram, Quran.com).",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["*://*.youtube.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-youtube.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["inject.js"], "matches": ["*://*.youtube.com/*"] }
  ]
}
